{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Exam": {
    "Title": "National & International Hackathon Screening 2026",
    "DurationMinutes": 30,
    "QuestionsPerExam": 20,
    "MaxViolations": 5,
    "SnapshotIntervalSeconds": 30,
    "ShuffleQuestions": true,
    "AllowRetake": false,
    "ShowScoreToCandidate": false
  },

  "Admin": {
    "Password": "admin@123",
    "EnableDemoTools": true
  },

  "Shortlist": {
    "CutoffPercent": 60,
    "NationalSeats": 10,
    "InternationalSeats": 5,
    "MinIntegrity": 60
  }
}
